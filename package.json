{
  "name": "workspace-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "A reusable, business-neutral React dashboard with Tabler components and a persistent responsive shell.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "@tabler/core": "1.6.1",
    "@tabler/icons-react": "3.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
